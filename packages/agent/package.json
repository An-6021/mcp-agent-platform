{
  "name": "@a1ua/mcp-hub",
  "version": "0.2.2",
  "description": "A local stdio MCP agent that loads personalized remote config and connects to upstream MCP services.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/aiua-dev/mcp-hub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiua-dev/mcp-hub.git",
    "directory": "packages/agent"
  },
  "bugs": {
    "url": "https://github.com/aiua-dev/mcp-hub/issues"
  },
  "files": [
    "dist/cli.js",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "mcp-hub": "dist/cli.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent",
    "codex",
    "claude-code",
    "opencode"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@a1ua/mcp-hub-runtime": "workspace:*",
    "@a1ua/mcp-hub-shared": "workspace:*"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "prepack": "pnpm run build",
    "lint": "echo \"(no lint configured)\""
  }
}
